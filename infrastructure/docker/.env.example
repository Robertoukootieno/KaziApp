# KaziApp Docker Environment Variables Template
# Copy this file to .env and configure your values

# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================
NODE_ENV=development
COMPOSE_PROJECT_NAME=kaziapp
DOCKER_REGISTRY=kaziapp

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=kaziapp
POSTGRES_USER=kaziapp
POSTGRES_PASSWORD=kaziapp_password
POSTGRES_URL=postgresql://kaziapp:kaziapp_password@postgres:5432/kaziapp

# MongoDB
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_DATABASE=kaziapp
MONGODB_USERNAME=kaziapp
MONGODB_PASSWORD=kaziapp_password
MONGODB_URL=mongodb://kaziapp:kaziapp_password@mongodb:27017/kaziapp

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379

# =============================================================================
# SERVICE PORTS
# =============================================================================
API_GATEWAY_PORT=3000
USER_SERVICE_PORT=3001
AUTH_SERVICE_PORT=3002
COMMUNICATION_PORT=3003
AI_DIAGNOSTICS_PORT=3004
MARKETPLACE_PORT=3005
FARM_MANAGEMENT_PORT=3006
PAYMENT_SERVICE_PORT=3007
NOTIFICATION_PORT=3008
COMMUNITY_PORT=3009
WEB_CLIENT_PORT=3010
ADMIN_CLIENT_PORT=3011
SERVICE_PROVIDER_CLIENT_PORT=3012
USSD_CLIENT_PORT=3013

# =============================================================================
# EXTERNAL API KEYS
# =============================================================================

# Kenya Veterinary Board API
KENYA_VET_BOARD_API_URL=https://api.kenyavetboard.go.ke
KENYA_VET_BOARD_API_KEY=your_vet_board_api_key

# Weather API
WEATHER_API_KEY=your_weather_api_key
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# SMS/Communication APIs
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
WHATSAPP_API_TOKEN=your_whatsapp_token
SMS_API_KEY=your_sms_api_key

# M-Pesa Payment Integration
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_SHORTCODE=your_mpesa_shortcode
MPESA_PASSKEY=your_mpesa_passkey
MPESA_ENVIRONMENT=sandbox

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Encryption Keys
ENCRYPTION_KEY=your_32_character_encryption_key_here
HASH_SALT_ROUNDS=12

# CORS Configuration
CORS_ORIGIN=http://localhost:3010,http://localhost:3011,http://localhost:3012

# =============================================================================
# KEYCLOAK CONFIGURATION
# =============================================================================
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=kaziapp
KEYCLOAK_CLIENT_ID=kaziapp-client
KEYCLOAK_CLIENT_SECRET=your_keycloak_client_secret

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
JAEGER_PORT=16686

# =============================================================================
# FILE STORAGE
# =============================================================================
UPLOAD_PATH=/app/uploads
MAX_FILE_SIZE=10MB
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=json

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
DEBUG=kaziapp:*
HOT_RELOAD=true
AUTO_RESTART=true
