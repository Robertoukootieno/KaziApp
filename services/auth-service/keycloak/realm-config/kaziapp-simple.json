{
  "realm": "kaziapp",
  "displayName": "KaziApp",
  "displayNameHtml": "<div class=\"kc-logo-text\"><span>KaziApp</span></div>",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "rememberMe": true,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "smtpServer": {
    "host": "smtp.gmail.com",
    "port": "587",
    "from": "noreply@kaziapp.com",
    "fromDisplayName": "KaziApp",
    "replyTo": "support@kaziapp.com",
    "replyToDisplayName": "KaziApp Support",
    "envelopeFrom": "noreply@kaziapp.com",
    "ssl": "false",
    "starttls": "true",
    "auth": "true",
    "user": "${SMTP_USER:noreply@kaziapp.com}",
    "password": "${SMTP_PASSWORD:your-app-password}"
  },
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 30,
  "defaultSignatureAlgorithm": "RS256",
  "revokeRefreshToken": false,
  "refreshTokenMaxReuse": 0,
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "ssoSessionIdleTimeoutRememberMe": 0,
  "ssoSessionMaxLifespanRememberMe": 0,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespanEnabled": false,
  "offlineSessionMaxLifespan": 5184000,
  "clientSessionIdleTimeout": 0,
  "clientSessionMaxLifespan": 0,
  "clientOfflineSessionIdleTimeout": 0,
  "clientOfflineSessionMaxLifespan": 0,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "accessCodeLifespanLogin": 1800,
  "actionTokenGeneratedByAdminLifespan": 43200,
  "actionTokenGeneratedByUserLifespan": 300,
  "oauth2DeviceCodeLifespan": 600,
  "oauth2DevicePollingInterval": 5,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "en",
    "sw"
  ],
  "defaultLocale": "en",
  "clients": [
    {
      "clientId": "kaziapp-farmer-mobile",
      "name": "KaziApp Farmer Mobile App",
      "description": "Mobile application for farmers",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "farmer-mobile-secret-2024",
      "redirectUris": [
        "kaziapp://auth/callback",
        "http://localhost:*"
      ],
      "webOrigins": [
        "*"
      ],
      "publicClient": true,
      "protocol": "openid-connect",
      "attributes": {
        "saml.assertion.signature": "false",
        "saml.force.post.binding": "false",
        "saml.multivalued.roles": "false",
        "saml.encrypt": "false",
        "saml.server.signature": "false",
        "saml.server.signature.keyinfo.ext": "false",
        "exclude.session.state.from.auth.response": "false",
        "saml_force_name_id_format": "false",
        "saml.client.signature": "false",
        "tls.client.certificate.bound.access.tokens": "false",
        "saml.authnstatement": "false",
        "display.on.consent.screen": "false",
        "saml.onetimeuse.condition": "false"
      },
      "authenticationFlowBindingOverrides": {},
      "fullScopeAllowed": true,
      "nodeReRegistrationTimeout": -1,
      "defaultClientScopes": [
        "web-origins",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },
    {
      "clientId": "kaziapp-provider-mobile",
      "name": "KaziApp Service Provider Mobile App",
      "description": "Mobile application for service providers",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "provider-mobile-secret-2024",
      "redirectUris": [
        "kaziapp-provider://auth/callback",
        "http://localhost:*"
      ],
      "webOrigins": [
        "*"
      ],
      "publicClient": true,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "web-origins",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    },
    {
      "clientId": "kaziapp-admin-web",
      "name": "KaziApp Admin Dashboard",
      "description": "Web dashboard for administrators",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "admin-web-secret-2024",
      "redirectUris": [
        "http://localhost:3002/*",
        "http://localhost:3012/*"
      ],
      "webOrigins": [
        "http://localhost:3002",
        "http://localhost:3012"
      ],
      "publicClient": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "web-origins",
        "profile",
        "roles",
        "email"
      ]
    },
    {
      "clientId": "kaziapp-backend-services",
      "name": "KaziApp Backend Services",
      "description": "Service account for backend services",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "backend-services-secret-2024",
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "attributes": {
        "access.token.lifespan": "3600"
      }
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "farmer",
        "description": "Agricultural producer role"
      },
      {
        "name": "service_provider",
        "description": "General service provider role"
      },
      {
        "name": "veterinarian",
        "description": "Animal health specialist role",
        "composite": true,
        "composites": {
          "realm": ["service_provider"]
        }
      },
      {
        "name": "agronomist",
        "description": "Crop specialist role",
        "composite": true,
        "composites": {
          "realm": ["service_provider"]
        }
      },
      {
        "name": "buyer",
        "description": "Marketplace buyer role"
      },
      {
        "name": "vendor",
        "description": "Input supplier role"
      },
      {
        "name": "admin",
        "description": "System administrator role"
      },
      {
        "name": "super_admin",
        "description": "Super administrator role",
        "composite": true,
        "composites": {
          "realm": ["admin", "farmer", "service_provider", "buyer", "vendor"]
        }
      }
    ]
  },
  "groups": [
    {
      "name": "Farmers",
      "path": "/Farmers",
      "realmRoles": ["farmer"],
      "subGroups": [
        {
          "name": "Crop Farmers",
          "path": "/Farmers/Crop Farmers"
        },
        {
          "name": "Livestock Farmers",
          "path": "/Farmers/Livestock Farmers"
        },
        {
          "name": "Mixed Farmers",
          "path": "/Farmers/Mixed Farmers"
        }
      ]
    },
    {
      "name": "Service Providers",
      "path": "/Service Providers",
      "realmRoles": ["service_provider"],
      "subGroups": [
        {
          "name": "Veterinarians",
          "path": "/Service Providers/Veterinarians",
          "realmRoles": ["veterinarian"]
        },
        {
          "name": "Agronomists",
          "path": "/Service Providers/Agronomists",
          "realmRoles": ["agronomist"]
        },
        {
          "name": "Equipment Providers",
          "path": "/Service Providers/Equipment Providers"
        }
      ]
    },
    {
      "name": "Marketplace Users",
      "path": "/Marketplace Users",
      "subGroups": [
        {
          "name": "Buyers",
          "path": "/Marketplace Users/Buyers",
          "realmRoles": ["buyer"]
        },
        {
          "name": "Vendors",
          "path": "/Marketplace Users/Vendors",
          "realmRoles": ["vendor"]
        }
      ]
    },
    {
      "name": "Administrators",
      "path": "/Administrators",
      "realmRoles": ["admin"],
      "subGroups": [
        {
          "name": "System Admins",
          "path": "/Administrators/System Admins",
          "realmRoles": ["super_admin"]
        },
        {
          "name": "Content Moderators",
          "path": "/Administrators/Content Moderators"
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "firstName": "System",
      "lastName": "Administrator",
      "email": "admin@kaziapp.com",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": ["super_admin"],
      "groups": ["/Administrators/System Admins"]
    }
  ]
}
